#!/usr/bin/env bash
# Blocks direct pushes to main. Every change must ride a branch + PR so the
# rebuilt PDF can be reviewed as a workflow artifact before it lands.
#
# Enabled via: git config core.hooksPath .githooks
# Deliberate override (rare): git push --no-verify

PROTECTED="main"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/$PROTECTED" ]; then
    cat >&2 <<EOF

  ✗ Direct push to '$PROTECTED' blocked.

    Put the change on a branch and open a PR instead:

      git switch -c edit/what-changed
      git push -u origin edit/what-changed
      gh pr create --fill

    CI rebuilds the PDF, attaches it to the run, and commits it to the
    branch — review it there, then merge.

EOF
    exit 1
  fi
done

exit 0
